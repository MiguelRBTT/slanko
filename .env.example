# Copy to .env and adjust if needed (do not commit .env)
DATABASE_URL="mysql://slanko:slanko@localhost:3306/slanko"

# JWT auth (use a long random string in production)
JWT_SECRET="change-me-to-a-long-random-secret"
JWT_EXPIRES_IN="8h"

# Token do Prometheus para /api/metrics (o mesmo valor está em docker/prometheus/prometheus.yml).
# Troque os dois em qualquer ambiente que não seja local.
METRICS_TOKEN="slanko-local-metrics-token"

# Só "true" atrás de um proxy reverso confiável (usa X-Forwarded-For no limite de login).
TRUST_PROXY="false"
